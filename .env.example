# API do DunasTour — chamada SOMENTE pelo servidor do Next (o IP do servidor precisa estar liberado no backend).
DUNASTOUR_API_URL=https://api.dunastour.com.br
# Slug da agência no DunasTour (dunastour.com.br/<slug>). A Destino Ideal ainda não tem conta: enquanto o slug
# não existir, o site usa o catálogo local (src/lib/local/tours.ts). Quando criarem a conta, ajuste o slug aqui.
DUNASTOUR_AGENCY_SLUG=destino-ideal-turismo
# URL pública deste site (SEO / Open Graph).
NEXT_PUBLIC_SITE_URL=https://destinoidealturismo.com.br
# Segredo do webhook /api/revalidate — o DunasTour chama com ele quando a agência salva um passeio, e o site
# atualiza na hora (sem esperar os 5 minutos de cache). O mesmo valor vai no cadastro do site no DunasTour.
REVALIDATE_SECRET=
